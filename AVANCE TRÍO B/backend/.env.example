# Servidor
NODE_ENV=development
PORT=3000
TZ=America/La_Paz
CORS_ORIGIN=http://localhost:5173

# Base de datos PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_contraseña_aqui
DB_NAME=parqueo_tarija
DB_POOL_MAX=10
DB_SSL=false

# Autenticación (JWT + bcrypt)
JWT_SECRET=genera_un_secreto_de_al_menos_32_caracteres
JWT_EXPIRES_IN=2h
BCRYPT_ROUNDS=10

# QR: deshabilitada, redenlace o simulada (solo desarrollo y pruebas).
PASARELA_PROVEEDOR=deshabilitada
PASARELA_SECRET=

# Credenciales del establecimiento asignadas por Red Enlace.
# Certificación: https://atcgwapitest.redenlace.com.bo/sandbox/
# Producción: https://api.redenlace.com.bo/
REDENLACE_URL=
REDENLACE_BASIC=
REDENLACE_CLIENT_ID=
REDENLACE_ID_ESTABLECIMIENTO=
REDENLACE_NOMBRE_ESTABLECIMIENTO=
REDENLACE_WEBHOOK_URL=

# Usuarios iniciales (npm run seed:usuarios). Si no se definen, se generan al azar y se muestran una vez.
# SEED_PASSWORD_ADMIN=
# SEED_PASSWORD_ENCARGADO=
