{
  "info": {
    "name": "Sistema de Parqueo - API",
    "description": "Colección de pruebas de la API REST del Sistema de Parqueo de Tarija. Los endpoints de reservas, pagos, fichas y autenticación se agregan en las siguientes actividades.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Estado",
      "item": [
        {
          "name": "Estado de la API",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/estado",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "estado"
              ]
            },
            "description": "Verifica que la API esté en ejecución."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"La API esta operativa\", () => pm.expect(pm.response.json().ok).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Estado de PostgreSQL",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/estado/bd",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "estado",
                "bd"
              ]
            },
            "description": "Verifica la conexión con PostgreSQL. Responde 503 mientras la base de datos no esté disponible."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Conecta con la base de datos\", () => pm.expect(pm.response.json().ok).to.eql(true));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Sectores",
      "item": [
        {
          "name": "Listar sectores",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sectores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sectores"
              ]
            },
            "description": "Lista los sectores activos con su total de lugares y lugares libres."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const respuesta = pm.response.json();",
                  "pm.test(\"Devuelve la lista de sectores\", () => pm.expect(respuesta.datos).to.be.an(\"array\"));",
                  "pm.test(\"Devuelve 2 sectores\", () => pm.expect(respuesta.datos.length).to.eql(2));"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar lugares de un sector",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sectores/{{idSector}}/lugares",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sectores",
                "{{idSector}}",
                "lugares"
              ]
            },
            "description": "Devuelve el sector y sus lugares ordenados por número."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const datos = pm.response.json().datos;",
                  "pm.test(\"Incluye el sector\", () => pm.expect(datos.sector).to.be.an(\"object\"));",
                  "pm.test(\"Devuelve 20 lugares\", () => pm.expect(datos.lugares.length).to.eql(20));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Reservas",
      "item": [
        {
          "name": "Crear reserva (5 minutos)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idLugar\": {{idLugar}},\n  \"placa\": \"1234ABC\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/reservas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reservas"
              ]
            },
            "description": "Reserva el lugar durante 5 minutos. Guarda idReserva y tokenReserva para las siguientes pruebas."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test(\"Estado ACTIVA\", () => pm.expect(r.datos.estado).to.eql(\"ACTIVA\"));",
                  "pm.collectionVariables.set(\"idReserva\", r.datos.id);",
                  "pm.collectionVariables.set(\"tokenReserva\", r.datos.tokenReserva);"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar reserva",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-reserva-token",
                "value": "{{tokenReserva}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reservas/{{idReserva}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reservas",
                "{{idReserva}}"
              ]
            },
            "description": "Consulta el estado de la reserva. Requiere el header x-reserva-token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancelar reserva",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-reserva-token",
                "value": "{{tokenReserva}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reservas/{{idReserva}}/cancelar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reservas",
                "{{idReserva}}",
                "cancelar"
              ]
            },
            "description": "Cancela dentro de los 5 minutos y libera el lugar."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Queda CANCELADA\", () => pm.expect(pm.response.json().datos.estado).to.eql(\"CANCELADA\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reservar un lugar ya reservado (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idLugar\": {{idLugar}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/reservas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reservas"
              ]
            },
            "description": "Debe responder 409 si el lugar no está libre."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201 o 409\", () => pm.expect([201, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Pagos y fichas",
      "item": [
        {
          "name": "Elegir pago por QR",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-reserva-token",
                "value": "{{tokenReserva}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"metodo\": \"QR\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/reservas/{{idReserva}}/pago",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reservas",
                "{{idReserva}}",
                "pago"
              ]
            },
            "description": "Genera el código QR (queda PENDIENTE hasta que el banco confirme). Guarda la referencia."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201 o 200\", () => pm.expect([200, 201]).to.include(pm.response.code));",
                  "const r = pm.response.json();",
                  "pm.collectionVariables.set(\"referenciaPago\", r.datos.referencia);"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirmar pago QR (pasarela)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-pasarela-secret",
                "value": "{{pasarelaSecret}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"referencia\": \"{{referenciaPago}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/pagos/qr/confirmar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pagos",
                "qr",
                "confirmar"
              ]
            },
            "description": "Simula la confirmación del banco. Requiere el header x-pasarela-secret (PASARELA_SECRET del .env)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Emite la ficha\", () => pm.expect(pm.response.json().datos.ficha.estado).to.eql(\"EMITIDA\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Elegir pago en efectivo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-reserva-token",
                "value": "{{tokenReserva}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"metodo\": \"EFECTIVO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/reservas/{{idReserva}}/pago",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reservas",
                "{{idReserva}}",
                "pago"
              ]
            },
            "description": "Emite la ficha de inmediato; el encargado cobra en el lugar."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Ficha emitida\", () => pm.expect(pm.response.json().datos.ficha.estado).to.eql(\"EMITIDA\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ver ficha de la reserva",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-reserva-token",
                "value": "{{tokenReserva}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reservas/{{idReserva}}/ficha",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reservas",
                "{{idReserva}}",
                "ficha"
              ]
            },
            "description": "El conductor vuelve a ver su ficha (RF-15)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "idSector",
      "value": "1",
      "type": "string"
    },
    {
      "key": "idLugar",
      "value": "1",
      "type": "string"
    },
    {
      "key": "idReserva",
      "value": "",
      "type": "string"
    },
    {
      "key": "tokenReserva",
      "value": "",
      "type": "string"
    },
    {
      "key": "referenciaPago",
      "value": "",
      "type": "string"
    },
    {
      "key": "pasarelaSecret",
      "value": "",
      "type": "string"
    }
  ]
}
