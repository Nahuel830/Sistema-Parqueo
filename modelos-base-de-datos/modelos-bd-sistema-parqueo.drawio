xCell id="c2" value="Notas: SERIAL = autoincremental · TIMESTAMP en hora de Bolivia (America/La_Paz) · estados como VARCHAR + CHECK · ON DELETE RESTRICT en todas las FK (el historial no se borra) · la reserva expira a los 5 min (fecha_expiracion = fecha_inicio + 5 min) y un job la pasa a EXPIRADA y libera el lugar." style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="-5" width="1800" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>