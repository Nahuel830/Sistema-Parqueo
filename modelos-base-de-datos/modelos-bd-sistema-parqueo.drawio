icio, fecha_expiracion, estado, fecha_cierre)&lt;br&gt;&lt;b&gt;PAGO&lt;/b&gt;(&lt;u&gt;id_pago&lt;/u&gt;, id_reserva→RESERVA, id_encargado→USUARIO, metodo, monto, estado, codigo_qr, referencia_pasarela, fecha_pago)&lt;br&gt;&lt;b&gt;FICHA&lt;/b&gt;(&lt;u&gt;id_ficha&lt;/u&gt;, id_reserva→RESERVA, id_pago→PAGO, id_encargado_verifica→USUARIO, codigo_unico, fecha_emision, estado, fecha_verificacion)&lt;br&gt;&lt;b&gt;CANCELACION&lt;/b&gt;(&lt;u&gt;id_cancelacion&lt;/u&gt;, id_reserva→RESERVA, tipo, motivo, fecha_cancelacion, segundos_transcurridos)&lt;br&gt;&lt;b&gt;NOTIFICACION&lt;/b&gt;(&lt;u&gt;id_notificacion&lt;/u&gt;, id_ficha→FICHA, id_encargado→USUARIO, fecha_envio, leida)&lt;br&gt;&lt;b&gt;BITACORA&lt;/b&gt;(&lt;u&gt;id_bitacora&lt;/u&gt;, id_usuario→USUARIO, entidad, id_entidad, accion, estado_anterior, estado_nuevo, fecha_hora)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fillColor=#fafafa;strokeColor=#cccccc;spacing=8;" vertex="1" parent="1"><mxGeometry x="1480" y="40" width="760" height="520" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3. Físico" id="p3"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2400" pageHeight="1700"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="MODELO FÍSICO – Sistema de Parqueo Tarija (PostgreSQL: tipos, restricciones e índices)" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="-30" width="1400" height="30" as="geometry"/></mxCell><mxCell id="fis_SECTOR" value="SECTOR" style="swimlane;fontStyle=1;startSize=30;horizontal=1;collapsible=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="470" height="178" as="geometry"/></mxCell><mxCell id="fis_SECTOR_0_0" value="id_sector" style="text;fillColor=#ffffff;strokeColor=#e0e0e0;align=left;spacingLeft=4;fontSize=10;fontStyle=1;overflow=hidden;" vertex="1" p